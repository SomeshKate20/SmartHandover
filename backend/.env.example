# Runtime
APP_ENV=development
DATABASE_URL=sqlite:///./digiplus.db
# Comma-separated deployed browser origins; localhost is always allowed for development.
CORS_ORIGINS=https://smart-handover.vercel.app,https://smart-handover-fiyv0jlok-someshs-projects-93b80e84.vercel.app

# Required for /api/ai/process-notes. Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Clerk JWT verification. Use the Frontend API issuer and its JWKS URL.
CLERK_ISSUER=https://your-clerk-frontend-api
CLERK_JWKS_URL=https://your-clerk-frontend-api/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=https://smart-handover.vercel.app,https://smart-handover-3a40vay71-someshs-projects-93b80e84.vercel.app,http://localhost:5173
